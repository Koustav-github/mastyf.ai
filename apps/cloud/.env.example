# Mastyf.ai Cloud Control Plane — Production Environment
#
# Deploy this app to Vercel, Render, or any Node.js hosting.
# Required: PostgreSQL database (DATABASE_URL)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/mastyf_cloud

# ── Authentication ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret

# ── OAuth Providers (at least one required for production) ─────
# GitHub OAuth: https://github.com/settings/developers
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Payments (Razorpay Standard Checkout) ──────────────────────
# https://dashboard.razorpay.com/app/website-app-settings/api-keys (rzp_test_… in test mode)
# The secret stays on the server: never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
# Webhook (event: order.paid) → https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Optional ───────────────────────────────────────────────────
# Upstash Redis for rate limiting (recommended for production)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Application URL (used for OAuth callbacks)
# AUTH_URL=https://cloud.mastyf.ai
